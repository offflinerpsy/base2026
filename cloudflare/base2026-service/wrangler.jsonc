{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "base2026-service-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": { "SERVICE_MODE": "disabled", "AZURE_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "SERVICE_DB",
      "database_name": "base2026-service-local-only",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SERVICE_ARTIFACTS",
      "bucket_name": "base2026-service-local-only",
    },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8789, "local_protocol": "http" },
}
